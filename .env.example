# ============================================================
# Example environment file — copy to `.env` and adjust.
#
#   cp .env.example .env
#
# This file contains PLACEHOLDER VALUES ONLY. Never put real
# credentials, tokens or account identifiers here, and never
# commit a real `.env` (it is listed in .gitignore).
#
# The application does not read .env today. These variables are
# reserved for non-interactive CLI runs (see scraper.py's
# `prompt_or_default`), which read them from the process
# environment when a prompt cannot be used.
# ============================================================

# Maximum messages to load per chat. 0 means unlimited.
SPLUS_MAX_MESSAGES=0

# Chat type to crawl: 1 = All, 2 = Private, 3 = Groups, 4 = Channels
SPLUS_TAB=1

# Which content types to download: y / n
SPLUS_DOWNLOAD_STICKER=y
SPLUS_DOWNLOAD_FILE=y
SPLUS_DOWNLOAD_VIDEO=y
SPLUS_DOWNLOAD_IMAGE=y
SPLUS_DOWNLOAD_AUDIO=y
SPLUS_DOWNLOAD_ALBUM=y
